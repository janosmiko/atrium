# Mirrors //chrome/browser/ui/webui_browser:headers - a tiny, dependency-free
# target so code outside chrome/browser/ui (e.g. chrome/browser/ui/read_anything)
# can query IsAtriumBrowserWindowEnabled() without depending on the rest of the
# mac-only atrium sources, which live inline in //chrome/browser/ui.
#
# atrium_devtools_bridge.h joins it for the same reason -
# chrome/browser/devtools (devtools_window.cc, devtools_window_views.cc)
# needs AtriumCanDockDevtools/MaybeUpdateAtriumDockedDevtools's declarations
# without a build dependency on the rest of the mac-only atrium sources.
# The reserved chrome-layer BrowserContext. Standalone rather than
# part of //chrome/browser/ui:ui so that //chrome/browser/ui/webui/atrium can
# depend on it: ui already deps on webui/atrium, so folding this in the other
# direction is a cycle.
source_set("chrome_context") {
  sources = [
    "atrium_chrome_context.h",
    "atrium_chrome_context.cc",
    # Renderer-crash recovery for the contents the context builds. Here rather
    # than in //chrome/browser/ui because that target already depends on this
    # one, so attaching the observer from the context would be a cycle.
    "atrium_chrome_contents_observer.h",
    "atrium_chrome_contents_observer.cc",
    "atrium_favicon_source.cc",
    "atrium_favicon_source.h",
    "atrium_icon_path.cc",
    "atrium_icon_path.h",

    # The app icon variants. Here rather than in //chrome/browser/ui because
    # the request filter in webui/atrium serves them, and ui already depends
    # on webui/atrium.
    "atrium_icon_source.cc",
    "atrium_icon_source.h",

    # The favourite parking store. Here because //chrome/browser/ui already
    # depends on this target, and a new target would need an edit to that
    # upstream BUILD.gn.
    "atrium_favorite_parking.cc",
    "atrium_favorite_parking.h",
    "atrium_sidebar_tabs.cc",
    "atrium_sidebar_tabs.h",
    # The seam between a WebUI controller and the widget that owns its
    # WebContents - needed by both sides, so it lives here too.
    "atrium_surface_host.h",
    "atrium_surface_host.cc",
  ]

  deps = [
    ":sidebar_model_source",
    "//base",
    "//chrome/browser:browser_process",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/resource_coordinator",
    "//chrome/common:constants",
    "//content/public/browser",
    "//third_party/atrium/core:atrium_core",
    "//url",
  ]
}

source_set("headers") {
  sources = [
    "atrium_devtools_bridge.h",
    "atrium_feature_check.h",
  ]
}

