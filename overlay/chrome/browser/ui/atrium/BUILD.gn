if (is_mac) {
  import("//build/config/mac/mac_sdk.gni")

  # Compiles the Swift helper by shelling out to swiftc directly - not a
  # tool("swift") target, since gn itself crashes (SIGSEGV) on any target
  # in this checkout's mac (non-iOS) toolchain declaring a .swift source.
  action("atrium_ai_fm_helper") {
    script = "build_ai_fm_helper.py"
    sources = [ "atrium_ai_foundation_models.swift" ]
    _output = "$root_out_dir/atrium_ai_fm_helper"
    outputs = [ _output ]
    args = [
      "--source",
      rebase_path("atrium_ai_foundation_models.swift", root_build_dir),
      "--output",
      rebase_path(_output, root_build_dir),
      "--target-cpu",
      target_cpu,
      "--deployment-target",
      mac_deployment_target,
    ]
  }

  # atrium_ai_backend_mac.cc looks up the helper via base::DIR_EXE, which
  # resolves to Contents/MacOS - it must land there, not in Resources.
  bundle_data("atrium_ai_fm_helper_bundle_data") {
    sources = [ "$root_out_dir/atrium_ai_fm_helper" ]
    outputs = [ "{{bundle_executable_dir}}/{{source_file_part}}" ]
    public_deps = [ ":atrium_ai_fm_helper" ]
  }

  source_set("ai_backend_mac") {
    sources = [
      "atrium_ai_backend_mac.cc",
      "atrium_ai_backend_mac.h",
    ]
    data_deps = [ ":atrium_ai_fm_helper" ]

    # For kTruncatedNote and the marker: the Swift helper builds its own prompt,
    # so this is where a cut page gets told about on the on-device route.
    deps = [
      ":ai_chat_prompt",
      ":ai_summarize_decision",
      "//base",
    ]
  }
}

