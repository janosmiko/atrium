<?xml version="1.0" encoding="utf-8"?>
<!-- Atrium chrome-layer resources.

     Hand-written rather than build_webui: that template asserts
     static_js_files == [] (ui/webui/resources/tools/build_webui.gni), so plain
     JS cannot pass through it, and docs/lab/swipe-lab.html is plain JS.

     resource_file_map_source (not resource_map_source) is what emits the third
     ResourcePath field carrying the on-disk path, which is what
     load_webui_from_disk reads at runtime. -->
<grit latest_public_release="0" current_release="1">
  <outputs>
    <output filename="grit/atrium_resources.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="grit/atrium_resources_map.cc"
      type="resource_file_map_source" />
    <output filename="grit/atrium_resources_map.h" type="resource_map_header" />
    <output filename="atrium_resources.pak" type="data_package" />
  </outputs>
  <release seq="1">
    <includes>
      <include name="IDR_ATRIUM_ATRIUM_HTML" file="atrium.html" type="BINDATA" />
      <include name="IDR_ATRIUM_TOKENS_CSS" file="tokens.css" type="BINDATA" />
      <include name="IDR_ATRIUM_OVERLAY_CSS" file="overlay.css" type="BINDATA" />
      <include name="IDR_ATRIUM_ARCHIVO_WOFF2" file="fonts/Archivo-Variable.woff2" type="BINDATA" />
      <include name="IDR_ATRIUM_EDGE_GLOW_JS" file="edge-glow.js" type="BINDATA" />
      <include name="IDR_ATRIUM_EDGE_GLOW_CSS" file="edge-glow.css" type="BINDATA" />
      <include name="IDR_ATRIUM_TOAST_STACK_JS" file="toast-stack.js" type="BINDATA" />
