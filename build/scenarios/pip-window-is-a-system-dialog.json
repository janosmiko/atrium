{
  "name": "pip-window-is-a-system-dialog",
  "description": "The mini player reports AX subrole AXSystemDialog. AeroSpace manages every AXStandardWindow of an app that is not on its hardcoded browser list, files it under a workspace and hides it on a workspace change. It ignores an AXSystemDialog, so the mini player stays on screen. The VM has no AeroSpace, so the subrole is the evidence.",
  "fixture": "repeated-row-drags.spaces.json",
  "settings": "auto-mini-player-audible.settings.json",
  "seed_prefs": "auto-pip-allowed.prefs.json",
  "chromium_flags": "--autoplay-policy=no-user-gesture-required",
  "app_process": "Atrium",
  "serve_fixtures": true,
  "actions": [
    {
      "type": "wait_vlog",
      "pattern": "Atrium: sidebar rows drawn [1-9]",
      "timeout_ms": 20000
    },
    {
      "type": "activate"
    },
    {
      "type": "settle",
      "ms": 1500
    },
    {
      "type": "key",
      "combo": "cmd+t"
    },
    {
      "type": "wait_vlog",
      "pattern": "Atrium: command bar widget showing",
      "timeout_ms": 10000
    },
    {
      "type": "type",
      "text": "file:///Users/admin/atrium-probe/vm-fixtures/video-with-sound.html"
    },
    {
      "type": "key",
      "combo": "return"
    },
    {
      "type": "settle",
      "ms": 2000
    },
    {
      "type": "eval",
      "id": "before",
      "target": "video-with-sound.html",
      "expression": "window.atriumPipState()",
      "note": "warms the debugging tunnel the eval_until below would otherwise spend its budget on"
    },
    {
      "type": "eval_until",
      "id": "premise",
      "target": "video-with-sound.html",
      "expression": "(() => { const v = document.getElementById('video'); return (v.paused ? 'paused' : 'playing') + ',' + (v.muted || v.volume === 0 ? 'muted' : 'unmuted'); })()",
      "expected": "playing,unmuted",
      "timeout_ms": 20000
    },
    {
      "type": "key",
      "combo": "cmd+opt+up"
    },
    {
      "type": "eval_until",
      "id": "after",
      "target": "video-with-sound.html",
      "expression": "window.atriumPipState()",
      "expected": "pip",
      "timeout_ms": 20000
    },
    {
      "type": "settle",
      "ms": 800
    },
    {
      "type": "click",
      "x": 721,
      "y": 570,
      "note": "Allow on every visit. The seeded content setting does not cover a file:// origin, and the prompt stands over the window this capture is for."
    },
    {
      "type": "settle",
      "ms": 1200
    },
    {
      "type": "settle",
      "ms": 3000
    }
  ],
  "assertions": [
    {
      "type": "eval_equals",
      "id": "after",
      "expected": "pip",
      "desc": "the mini player is open"
    },
    {
      "type": "ax_window_subrole",
      "title": "Picture in Picture",
      "expected": "AXSystemDialog",
      "desc": "the subrole that a tiling window manager reads"
    },
    {
      "type": "ax_window_subrole",
      "title": "Untitled",
      "expected": "AXStandardWindow",
      "desc": "the browser window stays a standard window, so the window manager still tiles it"
    },
    {
      "type": "quit",
      "desc": "Cmd+Q still quits cleanly"
    }
  ]
}
