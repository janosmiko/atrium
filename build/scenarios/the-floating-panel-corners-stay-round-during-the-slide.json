      "ms": 4000
    },
    {
      "type": "activate"
    },
    {
      "type": "move_window",
      "x": 0,
      "y": 40
    },
    {
      "type": "resize",
      "w": 560,
      "h": 500
    },
    {
      "type": "key",
      "combo": "cmd+l"
    },
    {
      "type": "type",
      "text": "http://127.0.0.1:8000/solid-white.html"
    },
    {
      "type": "key",
      "combo": "return"
    },
    {
      "type": "settle",
      "ms": 2000
    },
    {
      "type": "key",
      "combo": "cmd+s"
    },
    {
      "type": "settle",
      "ms": 2500
    },
    {
      "type": "move",
      "x": 300,
      "y": 400
    },
    {
      "type": "capture",
