{
  "name": "pip-controls-top-row",
  "description": "The mini player shows back-to-tab in the top left corner, no jump-to-start button, and the larger control buttons. The window is a native VideoOverlayWindowViews with no CDP target, so the evidence is a capture with the pointer over the window.",
  "fixture": "repeated-row-drags.spaces.json",
  "settings": "auto-mini-player-audible.settings.json",
  "seed_prefs": "auto-pip-allowed.prefs.json",
  "chromium_flags": "--autoplay-policy=no-user-gesture-required",
  "app_process": "Atrium",
  "serve_fixtures": true,
  "actions": [
    {
      "type": "wait_vlog",
      "pattern": "Atrium: sidebar rows drawn [1-9]",
      "timeout_ms": 20000
    },
    {
      "type": "activate"
    },
    {
      "type": "settle",
      "ms": 1500
    },
    {
      "type": "key",
      "combo": "cmd+t"
    },
    {
      "type": "wait_vlog",
      "pattern": "Atrium: command bar widget showing",
      "timeout_ms": 10000
    },
    {
      "type": "type",
      "text": "file:///Users/admin/atrium-probe/vm-fixtures/video-with-sound.html"
    },
    {
      "type": "key",
      "combo": "return"
    },
    {
      "type": "settle",
      "ms": 2000
    },
    {
      "type": "eval",
      "id": "before",
      "target": "video-with-sound.html",
      "expression": "window.atriumPipState()",
      "note": "warms the debugging tunnel the eval_until below would otherwise spend its budget on"
    },
    {
      "type": "eval_until",
      "id": "premise",
      "target": "video-with-sound.html",
      "expression": "(() => { const v = document.getElementById('video'); return (v.paused ? 'paused' : 'playing') + ',' + (v.muted || v.volume === 0 ? 'muted' : 'unmuted'); })()",
      "expected": "playing,unmuted",
      "timeout_ms": 20000
    },
    {
      "type": "key",
      "combo": "cmd+opt+up"
    },
    {
      "type": "eval_until",
      "id": "after",
      "target": "video-with-sound.html",
      "expression": "window.atriumPipState()",
      "expected": "pip",
      "timeout_ms": 20000
    },
    {
      "type": "settle",
      "ms": 800
    },
    {
      "type": "click",
      "x": 721,
      "y": 570,
      "note": "Allow on every visit. The seeded content setting does not cover a file:// origin, and the prompt stands over the window this capture is for."
    },
    {
      "type": "eval",
      "id": "freeze",
      "target": "video-with-sound.html",
      "expression": "(() => { const v = document.getElementById('video'); v.pause(); v.currentTime = 1.0; return 'frozen'; })()",
      "note": "the mini player mirrors this frame, so the two captures below differ only in what Chromium draws over it"
    },
    {
      "type": "settle",
      "ms": 1200
    },
    {
      "type": "move",
      "x": 690,
      "y": 480,
      "note": "over the mini player, so Chromium fades its controls in"
    },
    {
      "type": "settle",
      "ms": 1500
    },
    {
      "type": "capture",
      "id": "hover",
      "duration_ms": 400,
      "fps": 5
    }
  ],
  "assertions": [
    {
      "type": "ax_window_count",
      "expected": 2,
      "min_area": 150000,
      "desc": "the line prints each window's position and size, which is what names the mismatch between the window and the video's aspect ratio"
    },
    {
      "type": "eval_equals",
      "id": "premise",
      "expected": "playing,unmuted",
      "desc": "the video really is playing with sound before the switch"
    },
    {
      "type": "eval_equals",
      "id": "after",
      "expected": "pip",
      "desc": "the mini player is open, so the capture holds the window this task is about"
    },
    {
      "type": "quit",
      "desc": "Cmd+Q still quits cleanly"
    }
  ]
}
