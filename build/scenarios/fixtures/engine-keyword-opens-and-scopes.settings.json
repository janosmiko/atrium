{
  "schemaVersion": 1,
  "appIconVariant": "solarized-ink",
  "animationsEnabled": true,
  "startupBehavior": "restoreLastActive",
  "downloadsDirectory": null,
  "promptForDownload": false,
  "sidebarPosition": "left",
  "horizontalScrollOverride": "auto",
  "archiveThreshold": "twelveHours",
  "memorySaverThreshold": "never",
  "importPromptShown": false,
  "autoPipEnabled": true,
  "confirmToQuitEnabled": false,
  "glassOpacity": 0.55,
  "opaqueSurround": false,
  "surroundColor": null,
  "searchEnginesSeed": 1,
  "searchEngines": [
    {
      "id": "google",
      "name": "Google",
      "keyword": "google.com",
      "url": "https://www.google.com/search?q=%s",
      "enabled": true,
      "builtin": true
    },
    {
      "id": "fixturemaps",
      "name": "Fixture Maps",
      "keyword": "maps",
      "url": "http://127.0.0.1:8000/engine-alpha.html?q=%s",
      "enabled": true,
      "builtin": false
    }
  ]
}
