{
  "name": "pip-click-does-not-activate-atrium",
  "description": "A click inside the mini player leaves the other app frontmost, and back-to-tab then activates Atrium with the browser window key. AeroSpace switches workspace only on an app activation or a managed window gaining focus, and it ignores the mini player, so a click that made Atrium active left back-to-tab with no activation to react to. The VM has no AeroSpace, so the frontmost app is the evidence.",
  "fixture": "repeated-row-drags.spaces.json",
  "settings": "auto-mini-player-audible.settings.json",
  "seed_prefs": "auto-pip-allowed.prefs.json",
  "chromium_flags": "--autoplay-policy=no-user-gesture-required",
  "app_process": "Atrium",
  "serve_fixtures": true,
  "actions": [
    {
      "type": "wait_vlog",
      "pattern": "Atrium: sidebar rows drawn [1-9]",
      "timeout_ms": 20000
    },
    {
      "type": "activate"
    },
    {
      "type": "settle",
      "ms": 1500
    },
    {
      "type": "key",
      "combo": "cmd+t"
    },
    {
      "type": "wait_vlog",
      "pattern": "Atrium: command bar widget showing",
      "timeout_ms": 10000
    },
    {
      "type": "type",
      "text": "file:///Users/admin/atrium-probe/vm-fixtures/video-with-sound.html"
    },
    {
      "type": "key",
      "combo": "return"
    },
    {
      "type": "settle",
      "ms": 2000
    },
    {
      "type": "eval",
      "id": "before",
      "target": "video-with-sound.html",
      "expression": "window.atriumPipState()",
      "note": "warms the debugging tunnel the eval_until below would otherwise spend its budget on"
    },
    {
      "type": "eval_until",
      "id": "premise",
      "target": "video-with-sound.html",
      "expression": "(() => { const v = document.getElementById('video'); return (v.paused ? 'paused' : 'playing') + ',' + (v.muted || v.volume === 0 ? 'muted' : 'unmuted'); })()",
      "expected": "playing,unmuted",
      "timeout_ms": 20000
    },
    {
      "type": "key",
      "combo": "cmd+opt+up"
    },
    {
      "type": "eval_until",
      "id": "after",
      "target": "video-with-sound.html",
      "expression": "window.atriumPipState()",
      "expected": "pip",
      "timeout_ms": 20000
    },
    {
      "type": "settle",
      "ms": 800
    },
    {
      "type": "click",
      "x": 721,
      "y": 570,
      "note": "Allow on every visit. The seeded content setting does not cover a file:// origin, and the prompt stands over the window this capture is for."
    },
    {
      "type": "settle",
      "ms": 1200
    },
    {
      "type": "activate",
      "app": "Finder",
      "note": "another app in front, the way the user sits in Ghostty"
    },
    {
      "type": "settle",
      "ms": 1000
    },
    {
      "type": "frontmost",
      "id": "premise_front"
    },
    {
      "type": "move",
      "x": 900,
      "y": 470,
      "note": "inside the mini player, clear of its buttons"
    },
    {
      "type": "settle",
      "ms": 800
    },
    {
      "type": "click",
      "x": 900,
      "y": 470
    },
    {
      "type": "settle",
      "ms": 1000
    },
    {
      "type": "frontmost",
      "id": "after_pip_click"
    },
    {
      "type": "move",
      "x": 449,
      "y": 393,
      "note": "back-to-tab, top left of the mini player at pos=429,372"
    },
    {
      "type": "settle",
      "ms": 1000
    },
    {
      "type": "click",
      "x": 449,
      "y": 393
    },
    {
      "type": "settle",
      "ms": 1500
    },
    {
      "type": "frontmost",
      "id": "after_back_to_tab"
    },
    {
      "type": "eval",
      "id": "tab_focus",
      "target": "video-with-sound.html",
      "expression": "[document.visibilityState, window.atriumPipState()].join(',')"
    }
  ],
  "assertions": [
    {
      "type": "eval_equals",
      "id": "after",
      "expected": "pip",
      "desc": "the mini player is open"
    },
    {
      "type": "eval_equals",
      "id": "premise_front",
      "expected": "Finder,none",
      "desc": "another app is frontmost before the click"
    },
    {
      "type": "eval_equals",
      "id": "after_pip_click",
      "expected": "Finder,none",
      "desc": "a click on the mini player does not activate Atrium"
    },
    {
      "type": "eval_equals",
      "id": "after_back_to_tab",
      "expected": "Atrium,AXStandardWindow",
      "desc": "back-to-tab activates Atrium with the browser window focused"
    },
    {
      "type": "eval_equals",
      "id": "tab_focus",
      "expected": "\"visible,in-tab\"",
      "desc": "back-to-tab shows the video tab and closes the mini player"
    },
    {
      "type": "quit",
      "desc": "Cmd+Q still quits cleanly"
    }
  ]
}
