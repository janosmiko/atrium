{
  "name": "a-space-switch-pops-the-video-out",
  "description": "The auto mini player on a space switch. A space switch changes no tab in the video's own strip: an empty space only clears the pane, and another profile's space shows another Browser's strip. Chromium's tab strip observer never hears of either, so the video stayed in its hidden tab. Each hop below crosses one of those cases, and each hop back must close the mini player again. The last step is a plain tab switch inside one space, which worked before and must still work.\n\nFixture order is Video (Default), Other (profile Second), Empty (Default). cmd+shift+left from the first space wraps to the last one.",
  "fixture": "auto-mini-player-across-spaces.spaces.json",
  "settings": "auto-mini-player-audible.settings.json",
  "seed_prefs": "auto-pip-allowed.prefs.json",
  "chromium_flags": "--autoplay-policy=no-user-gesture-required",
  "app_process": "Atrium",
  "serve_fixtures": true,
  "actions": [
    {
      "type": "wait_vlog",
      "pattern": "Atrium: sidebar rows drawn [1-9]",
      "timeout_ms": 20000
    },
    {
      "type": "activate"
    },
    {
      "type": "settle",
      "ms": 1500
    },
    {
      "type": "key",
      "combo": "cmd+t",
      "note": "the command bar, because restore refuses a file:// row"
    },
    {
      "type": "wait_vlog",
      "pattern": "Atrium: command bar widget showing",
      "timeout_ms": 10000
    },
    {
      "type": "type",
      "text": "file:///Users/admin/atrium-probe/vm-fixtures/video-with-sound.html"
    },
    {
      "type": "key",
      "combo": "return"
    },
    {
      "type": "settle",
      "ms": 2000
    },
    {
      "type": "eval",
      "id": "before",
      "target": "video-with-sound.html",
      "expression": "window.atriumPipState()",
      "note": "also warms the debugging tunnel"
    },
    {
      "type": "eval_until",
      "id": "premise",
      "target": "video-with-sound.html",
      "expression": "(() => { const v = document.getElementById('video'); return (v.paused ? 'paused' : 'playing') + ',' + (v.muted || v.volume === 0 ? 'muted' : 'unmuted'); })()",
      "expected": "playing,unmuted",
      "timeout_ms": 20000
    },
    {
      "type": "key",
      "combo": "cmd+shift+right",
      "note": "to Other, a space on another profile"
    },
    {
      "type": "wait_vlog",
      "pattern": "Atrium: active space 0 -> 1",
      "timeout_ms": 10000
    },
    {
      "type": "eval_until",
      "id": "other-profile",
      "target": "video-with-sound.html",
      "expression": "window.atriumPipState()",
      "expected": "pip",
      "timeout_ms": 20000
    },
    {
      "type": "key",
      "combo": "cmd+shift+left",
      "note": "back to Video"
    },
    {
      "type": "wait_vlog",
      "pattern": "Atrium: active space 1 -> 0",
      "timeout_ms": 10000
    },
    {
      "type": "eval_until",
      "id": "back-from-other-profile",
      "target": "video-with-sound.html",
      "expression": "window.atriumPipState()",
      "expected": "in-tab",
      "timeout_ms": 20000
    },
    {
      "type": "key",
      "combo": "cmd+shift+left",
      "note": "wraps to Empty, a space with no tabs"
    },
    {
      "type": "wait_vlog",
      "pattern": "Atrium: active space 0 -> 2",
      "timeout_ms": 10000
    },
    {
      "type": "eval_until",
      "id": "empty-space",
      "target": "video-with-sound.html",
      "expression": "window.atriumPipState()",
      "expected": "pip",
      "timeout_ms": 20000
    },
    {
      "type": "key",
      "combo": "cmd+shift+right",
      "note": "wraps back to Video"
    },
    {
      "type": "wait_vlog",
      "pattern": "Atrium: active space 2 -> 0",
      "timeout_ms": 10000
    },
    {
      "type": "eval_until",
      "id": "back-from-empty-space",
      "target": "video-with-sound.html",
      "expression": "window.atriumPipState()",
      "expected": "in-tab",
      "timeout_ms": 20000
    },
    {
      "type": "key",
      "combo": "cmd+opt+up",
      "note": "previousTab, a tab switch inside the Video space"
    },
    {
      "type": "eval_until",
      "id": "tab-switch",
      "target": "video-with-sound.html",
      "expression": "window.atriumPipState()",
      "expected": "pip",
      "timeout_ms": 20000
    }
  ],
  "assertions": [
    {
      "type": "eval_equals",
      "id": "premise",
      "expected": "playing,unmuted",
      "desc": "the video really is playing with sound before any switch"
    },
    {
      "type": "eval_equals",
      "id": "before",
      "expected": "\"in-tab\"",
      "desc": "nothing has popped out while the tab is on screen"
    },
    {
      "type": "eval_equals",
      "id": "other-profile",
      "expected": "pip",
      "desc": "a switch to another profile's space opens the mini player"
    },
    {
      "type": "eval_equals",
      "id": "back-from-other-profile",
      "expected": "in-tab",
      "desc": "switching back closes it"
    },
    {
      "type": "eval_equals",
      "id": "empty-space",
      "expected": "pip",
      "desc": "a switch to an empty space opens the mini player"
    },
    {
      "type": "eval_equals",
      "id": "back-from-empty-space",
      "expected": "in-tab",
      "desc": "switching back closes it"
    },
    {
      "type": "eval_equals",
      "id": "tab-switch",
      "expected": "pip",
      "desc": "a tab switch inside one space still opens it"
    },
    {
      "type": "quit",
      "desc": "Cmd+Q still quits cleanly"
    }
  ]
}
