{
  "name": "page-hover-works-before-the-first-click-after-a-row-click",
  "description": "The row-click side of page-hover-works-before-the-first-click. A click on a sidebar row shows a tab through ShowTab, which also arms the reattach heal. First the startup tab with no row click (the baseline), then a cold row (?b), then the live startup row (?a). After each click the pointer moves onto the page's button with no click on the page, and one letter key is typed. Red while the bug is there.",
  "fixture": "hover-probe.spaces.json",
  "startup_space": "48b00000-0000-4000-8000-000000000481",
  "app_process": "Atrium",
  "serve_fixtures": true,
