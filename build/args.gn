# Fast developer build: release-ish, component (small relinks), no symbols.
is_debug = false
is_component_build = true
symbol_level = 0
blink_symbol_level = 0
target_cpu = "arm64"

# H.264/AAC playback (YouTube and most of the web serve these; default
# free-codecs-only build left MEDIA_ERR_SRC_NOT_SUPPORTED on H.264 sources).
proprietary_codecs = true
ffmpeg_branding = "Chrome"

# Serve WebUI resources from disk in dev builds, so
# editing a chrome page and reloading needs no rebuild. Adds file-path info to
# the grit-generated *_resource_map.cc; still requires --load-webui-from-disk
# at runtime. Local development only - see ui/webui/webui_features.gni:20-27.
load_webui_from_disk = true

# build the real third-party notice set instead of the placeholder.
# The default is is_official_build, so a dev build served
# components/resources/sample_credits.html at chrome://credits - a stub, not the
# notices Chromium's BSD-3 terms require a binary to reproduce. True runs
# tools/licenses/licenses.py over the tree (~761 entries) and bakes the result
# into resources.pak, so the page is generated by the build and readable
# offline. Costs one filesystem traversal, and only when a license file moves.
generate_about_credits = true

# A dev build applies testing/variations/fieldtrial_testing_config.json, which
# turns on TLS experiments (TLSTrustAnchorIDs, server padding) that Chrome
# stable does not ship. The ClientHello then carries two extra extensions, and
# Reddit's WAF scores that fingerprint as a bot: login answers 400 and some
# same-origin fetches answer 403. Off, the JA4 matches Chrome 151 exactly.
disable_fieldtrial_testing_config = true

# A dev build turns on expensive DCHECKs, and Blink's two-pass max-size
# self-check (core/layout/inline/inline_node.cc, ComputeContentSize) fails on
# reddit.com by 8 px and aborts the renderer. Ordinary DCHECKs stay on.
enable_expensive_dchecks = false

# Xcode 27's SDK stubs declare an arm64e.x1 target that the ld64.lld in clang
# 23 cannot parse, and Xcode 27 removed the 26.5 SDK this tree expects. The
# link to the Command Line Tools SDK comes from build-shell.sh.
mac_sdk_path = "//out/atrium/sdk/clt_sdk"
