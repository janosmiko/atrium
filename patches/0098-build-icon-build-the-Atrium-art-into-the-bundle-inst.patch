 <693558+janosmiko@users.noreply.github.com>
Date: Sun, 30 Aug 2026 23:11:25 +0200
Subject: [PATCH 098/154] build(icon): build the Atrium art into the bundle
 instead of copying it in after
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The bundle carried Chromium's icon and a post-link step replaced it, so the art
survived only until the next raw ninja build re-created the bundle from its own
rules. The Dock then showed the Chromium icon, and the Auto choice could never
be right, since Auto clears the runtime override so the bundle can lead.

The icon and asset catalog targets now source the Atrium art directly, so any
invocation that produces the bundle produces it correct. Replacing the checked-in
theme art would have been the smaller change to describe and a far larger one to
carry: it is 31MB of binary that the patch series exports as text.

Signed-off-by: János Mikó <693558+janosmiko@users.noreply.github.com>
---
 chrome/BUILD.gn | 22 ++++++++++++++++++++--
 1 file changed, 20 insertions(+), 2 deletions(-)

diff --git a/chrome/BUILD.gn b/chrome/BUILD.gn
index bc8f87a55fb21..ee5ca4b898a28 100644
--- a/chrome/BUILD.gn
+++ b/chrome/BUILD.gn
@@ -71,6 +71,10 @@ declare_args() {
   # signing identity. If `include_branded_entitlements` is set to false, these
   # entitlements will be skipped.
   include_branded_entitlements = true
+
+  # Absolute path to the Atrium harness repo, set by build-shell.sh. A binary
+  # asset committed under chrome/ rides every regen-patches.sh export.
+  atrium_repo_dir = ""
 }
 
 assert(!is_ios, "Chromium/iOS shouldn't use anything in //chrome")
@@ -641,14 +645,28 @@ if (is_win) {
     }
   }
 
+  # Copies rather than a direct bundle_data source: atrium_repo_dir sits
+  # outside //chrome, and bundle_data sources must resolve inside the tree.
+  copy("atrium_app_icon_copy") {
+    sources = [ "$atrium_repo_dir/build/atrium.icns" ]
+    outputs = [ "$target_gen_dir/atrium-icons/app.icns" ]
+  }
+
+  copy("atrium_asset_catalog_copy") {
+    sources = [ "$atrium_repo_dir/build/Assets.car" ]
+    outputs = [ "$target_gen_dir/atrium-icons/Assets.car" ]
+  }
+
   bundle_data("chrome_app_icon") {
-    sources = [ "app/theme/$branding_path_component/mac/app.icns" ]
+    sources = [ "$target_gen_dir/atrium-icons/app.icns" ]
     outputs = [ "{{bundle_resources_dir}}/{{source_file_part}}" ]
+    public_deps = [ ":atrium_app_icon_copy" ]
   }
 
   bundle_data("chrome_asset_catalog") {
-    sources = [ "app/theme/$branding_path_component/mac/Assets.car" ]
+    sources = [ "$target_gen_dir/atrium-icons/Assets.car" ]
     outputs = [ "{{bundle_resources_dir}}/{{source_file_part}}" ]
+    public_deps = [ ":atrium_asset_catalog_copy" ]
   }
 
   bundle_data("chrome_resources") {
