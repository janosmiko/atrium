diff --git a/chrome/browser/ui/cocoa/confirm_quit.cc b/chrome/browser/ui/cocoa/confirm_quit.cc
index e28f7554e2783..c0c47804f79ec 100644
--- a/chrome/browser/ui/cocoa/confirm_quit.cc
+++ b/chrome/browser/ui/cocoa/confirm_quit.cc
@@ -15,6 +15,17 @@ void RecordHistogram(ConfirmQuitMetric sample) {
 }
 
 void RegisterLocalState(PrefRegistrySimple* registry) {
+  // Atrium: registers the stock default (true - ask before
+  // quitting). A prior milestone shipped this default as
+  // false, because a plain Cmd+Q tap never satisfies the hold-to-quit loop
+  // and so silently no-ops in the empty/NTP and web-focused states. This
+  // supersedes that workaround: users demonstrably do hit this prompt
+  // (one report was of it rendering behind windows) and asked for an
+  // explicit way to turn it off, so the Settings > General "Ask before
+  // quitting" toggle (AtriumHostOps.set_confirm_to_quit) is now the
+  // supported opt-out, and the default reverts to matching stock Chrome. The
+  // app-menu toggle (toggleConfirmToQuit:) and the new Settings toggle both
+  // read/write this SAME pref, so they always agree.
   registry->RegisterBooleanPref(prefs::kConfirmToQuitEnabled, true);
 }
 
diff --git a/chrome/browser/ui/cocoa/confirm_quit_panel_controller.mm b/chrome/browser/ui/cocoa/confirm_quit_panel_controller.mm
index a3d287019fe4a..39d8c13c4adc5 100644
--- a/chrome/browser/ui/cocoa/confirm_quit_panel_controller.mm
+++ b/chrome/browser/ui/cocoa/confirm_quit_panel_controller.mm
@@ -219,6 +219,29 @@ BOOL isKeyDownForKeyCode(unsigned short keyCode) {
     window.opaque = NO;
     window.hasShadow = NO;
     window.releasedWhenClosed = NO;
+    // Atrium: at the default kCGNormalWindowLevel (same level as every
+    // browser window, chromeless or not), staying on top depends entirely on
+    // order-front timing - fine for stock Chrome's single-window case, but
+    // Atrium's chromeless window can win that race, landing this panel
+    // behind it. Float above kCGNormalWindowLevel outright (the same level
+    // Chromium's own floating widgets use, see CGWindowLevelForZOrderLevel's
+    // kFloatingWindow case in native_widget_mac.mm) so visibility no longer
+    // depends on ordering.
+    window.level = NSFloatingWindowLevel;
+    // Atrium: the level fix above still leaves this panel behind
+    // the browser window whenever that window is in native (Space-owning)
+    // full screen - AtriumBrowserWindow supports fullscreen, and
+    // NativeWidgetNSWindowBridge marks such windows
+    // NSWindowCollectionBehaviorFullScreenPrimary, so they get their own
+    // Space. A window without FullScreenAuxiliary/CanJoinAllSpaces cannot
+    // render over that Space, so this panel either loses the race during the
+    // forced Space-switch or simply doesn't surface on top - the "randomly
+    // appears behind the window" report. Mark it as a utility overlay that
+    // joins whichever Space (fullscreen or not) is currently active, the
+    // same incantation macOS system HUDs (volume, Spotlight) use to stay
+    // visible over full-screen apps.
+    window.collectionBehavior = NSWindowCollectionBehaviorCanJoinAllSpaces |
+                                 NSWindowCollectionBehaviorFullScreenAuxiliary;
 
     // Create the content view. Take the frame from the existing content view.
     NSRect frame = window.contentView.frame;
