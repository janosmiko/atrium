+- (void)setLabel:(NSTextField*)label
+            text:(NSString*)text
+      attributes:(NSDictionary*)attributes {
+  label.attributedStringValue =
+      [[NSAttributedString alloc] initWithString:text attributes:attributes];
+  label.hidden = text.length == 0;
+}
