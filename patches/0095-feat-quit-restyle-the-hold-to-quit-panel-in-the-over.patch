+// Recomputed on every show, not just at -init: dark/light and the native-app
+// chrome setting can both change mid-session, and this HUD is shown many
+// times over one.
+- (void)refreshAppearanceAndShortcut {
+  const atrium::ConfirmQuitLabelParts parts = atrium::SplitConfirmQuitLabel(
+      l10n_util::GetStringUTF16(IDS_CONFIRM_TO_QUIT_DESCRIPTION),
+      base::SysNSStringToUTF16(ConfirmQuitPanelController.keyCommandString));
+  NSMutableArray<NSString*>* caps = [NSMutableArray array];
+  for (const std::u16string& cap : parts.caps) {
+    [caps addObject:base::SysUTF16ToNSString(cap)];
+  }
+  [_contentView applyStyle:CurrentPanelStyle()
+                     prefix:base::SysUTF16ToNSString(parts.prefix)
+               shortcutCaps:caps
+                     suffix:base::SysUTF16ToNSString(parts.suffix)];
+}
