+- (NSSize)fittingSizeOfRowView:(NSView*)view {
+  if ([view isKindOfClass:[AtriumConfirmQuitKeyCapView class]]) {
+    return [(AtriumConfirmQuitKeyCapView*)view fittingSize];
+  }
+  // -cellSize, not the attributed string's own size: the cell insets its text
+  // by 2pt a side, so the string size draws the label 4pt too narrow.
+  return [((NSTextField*)view).cell cellSize];
+}
+
+// Content-fit rather than fixed: the string is localized, and the shortcut
+// itself is whatever the app menu's Quit item resolves to.
+- (void)layoutRowAndResizeWindow {
+  NSMutableArray<NSValue*>* sizes = [NSMutableArray array];
+  CGFloat totalWidth = 0;
+  CGFloat maxHeight = 0;
+  for (NSUInteger i = 0; i < _rowViews.count; ++i) {
+    NSSize size = [self fittingSizeOfRowView:_rowViews[i]];
+    [sizes addObject:[NSValue valueWithSize:size]];
+    maxHeight = std::max(maxHeight, size.height);
+    if (i > 0) {
+      totalWidth += [self gapBefore:i];
+    }
+    totalWidth += size.width;
+  }
+
+  const NSSize contentSize = NSMakeSize(totalWidth + kOuterPaddingX * 2,
+                                        maxHeight + kOuterPaddingY * 2);
+  [self.window setContentSize:contentSize];
+  self.frame = NSMakeRect(0, 0, contentSize.width, contentSize.height);
+
+  CGFloat x = kOuterPaddingX;
+  const CGFloat centerY = contentSize.height / 2;
+  for (NSUInteger i = 0; i < _rowViews.count; ++i) {
+    if (i > 0) {
+      x += [self gapBefore:i];
+    }
+    const NSSize size = sizes[i].sizeValue;
+    _rowViews[i].frame =
+        NSMakeRect(x, centerY - size.height / 2, size.width, size.height);
+    x += size.width;
+  }
+}
+
+- (CGFloat)gapBefore:(NSUInteger)index {
+  const BOOL bothCaps =
+      [_rowViews[index] isKindOfClass:[AtriumConfirmQuitKeyCapView class]] &&
+      [_rowViews[index - 1] isKindOfClass:[AtriumConfirmQuitKeyCapView class]];
+  return bothCaps ? kCapGap : kGroupGap;
 }
 
