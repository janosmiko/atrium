+// One keycap chip. Bare in native mode - a transparent key_background and
+// key_underline already paint nothing, so no mode flag of its own is needed.
+@interface AtriumConfirmQuitKeyCapView : NSView {
+ @private
+  NSString* __strong _glyph;
+  SkColor _background;
+  SkColor _underline;
+  SkColor _ink;
+  CGFloat _paddingX;
+  CGFloat _paddingY;
+}
+- (instancetype)initWithGlyph:(NSString*)glyph
+                        style:(const atrium::ConfirmQuitPanelStyle&)style;
+- (NSSize)fittingSize;
+@end
+
+@implementation AtriumConfirmQuitKeyCapView
+
+- (instancetype)initWithGlyph:(NSString*)glyph
+                        style:(const atrium::ConfirmQuitPanelStyle&)style {
+  if ((self = [super initWithFrame:NSZeroRect])) {
+    _glyph = [glyph copy];
+    _background = style.key_background;
+    _underline = style.key_underline;
+    _ink = style.ink;
+    _paddingX = style.key_padding_horizontal;
+    _paddingY = style.key_padding_vertical;
+  }
+  return self;
+}
+
+- (NSDictionary*)textAttributes {
+  return @{
+    NSFontAttributeName : [NSFont monospacedDigitSystemFontOfSize:15
+                                                             weight:NSFontWeightSemibold],
+    NSForegroundColorAttributeName : skia::SkColorToSRGBNSColor(_ink),
+  };
+}
+
+- (NSSize)fittingSize {
+  NSSize text = [_glyph sizeWithAttributes:self.textAttributes];
+  return NSMakeSize(std::max<CGFloat>(text.width, 14) + _paddingX * 2,
+                    text.height + _paddingY * 2);
+}
+
+- (void)drawRect:(NSRect)dirtyRect {
+  NSRect bounds = self.bounds;
+  NSBezierPath* path = [NSBezierPath bezierPathWithRoundedRect:bounds
+                                                        xRadius:kCapRadius
+                                                        yRadius:kCapRadius];
+  [skia::SkColorToSRGBNSColor(_background) set];
+  [path fill];
+  [skia::SkColorToSRGBNSColor(_underline) set];
+  NSRectFill(NSMakeRect(NSMinX(bounds), NSMinY(bounds), NSWidth(bounds), 2));
+
+  NSDictionary* attrs = self.textAttributes;
+  NSSize text = [_glyph sizeWithAttributes:attrs];
+  [_glyph drawAtPoint:NSMakePoint(NSMidX(bounds) - text.width / 2,
+                                  NSMidY(bounds) - text.height / 2)
+       withAttributes:attrs];
+}
+
+@end
