+void ShellPlatformDelegate::AtriumShowShell(Shell* shell) {
+  if (!shell_data_map_.contains(shell)) {
+    return;
+  }
+  for (auto& [other_shell, data] : shell_data_map_) {
+    if (data.delegate.window != g_atrium_window) {
+      continue;  // Not a tab (e.g. DevTools front-end); leave it alone.
+    }
+    NSView* view =
+        other_shell->web_contents()->GetNativeView().GetNativeNSView();
+    view.hidden = (other_shell != shell);
+  }
+  NSView* active_view =
+      shell->web_contents()->GetNativeView().GetNativeNSView();
+  [g_atrium_window makeFirstResponder:active_view];
+}
+
 void ShellPlatformDelegate::ResizeWebContent(Shell* shell,
                                              const gfx::Size& content_size) {
   DCHECK(shell_data_map_.contains(shell));
@@ -301,6 +426,36 @@ bool ShellPlatformDelegate::DestroyShell(Shell* shell) {
   DCHECK(shell_data_map_.contains(shell));
   ShellData& shell_data = shell_data_map_[shell];
 
+  if (atrium::TabHost::Get()->connected() &&
+      shell_data.delegate.window == g_atrium_window &&
+      Shell::windows().size() > 1) {
+    // Atrium tab close: other tabs still share this window, so keep it
+    // open and only tear down this shell's view.
+    [shell->web_contents()->GetNativeView().GetNativeNSView()
+        removeFromSuperview];
+    Shell* next = nullptr;
+    for (Shell* other : Shell::windows()) {
+      if (other != shell)
+        next = other;
+    }
+    // CleanUp() will deallocate this shell's delegate; don't leave the
+    // shared window's delegate pointer dangling on it.
