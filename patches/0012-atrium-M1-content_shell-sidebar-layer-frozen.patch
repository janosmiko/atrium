+// content/shell/browser/atrium_tab_host.mm
+#include "content/shell/browser/atrium_tab_host.h"
+
+#include <dlfcn.h>
+
+#include "base/strings/sys_string_conversions.h"
+#include "base/strings/utf_string_conversions.h"
+#include "content/public/browser/web_contents.h"
+#include "content/shell/browser/shell.h"
+#include "ui/gfx/geometry/size.h"
+
+namespace atrium {
+namespace {
+
+content::Shell* ShellFromId(uint64_t tab_id) {
+  // Validate against the live shell list instead of trusting the pointer.
+  for (content::Shell* shell : content::Shell::windows()) {
+    if (TabHost::IdFor(shell) == tab_id) {
+      return shell;
+    }
+  }
+  return nullptr;
+}
+
+// --- AtriumHostOps implementation (Swift -> browser) ---
+
+void HostNavigate(AtriumHost* host, uint64_t tab_id, const char* url) {
+  if (content::Shell* shell = ShellFromId(tab_id)) {
+    shell->LoadURL(GURL(url));
+  }
+}
+
+void HostNewTab(AtriumHost* host) {
+  if (content::Shell::windows().empty()) {
+    return;
+  }
+  content::Shell* seed = content::Shell::windows()[0];
+  content::Shell::CreateNewWindow(
+      seed->web_contents()->GetBrowserContext(), GURL("about:blank"),
+      nullptr, gfx::Size());
+}
+
+void HostCloseTab(AtriumHost* host, uint64_t tab_id) {
+  if (content::Shell* shell = ShellFromId(tab_id)) {
+    shell->Close();
+  }
+}
+
+void HostActivateTab(AtriumHost* host, uint64_t tab_id) {
+  if (content::Shell* shell = ShellFromId(tab_id)) {
+    content::Shell::SetAtriumActiveShell(shell);
+  }
+}
+
+void HostGoBack(AtriumHost* host, uint64_t tab_id) {
+  if (content::Shell* shell = ShellFromId(tab_id)) {
+    shell->GoBackOrForward(-1);
+  }
+}
+
+void HostGoForward(AtriumHost* host, uint64_t tab_id) {
+  if (content::Shell* shell = ShellFromId(tab_id)) {
+    shell->GoBackOrForward(1);
+  }
+}
+
+void HostReload(AtriumHost* host, uint64_t tab_id) {
+  if (content::Shell* shell = ShellFromId(tab_id)) {
+    shell->Reload();
+  }
+}
+
+constexpr AtriumHostOps kHostOps = {
+    &HostNavigate,  &HostNewTab,    &HostCloseTab, &HostActivateTab,
+    &HostGoBack,    &HostGoForward, &HostReload,
+};
+
+}  // namespace
+
+// static
+TabHost* TabHost::Get() {
+  static TabHost* instance = new TabHost();
+  return instance;
+}
+
+TabHost::TabHost() {
+  const char* dylib_path = getenv("ATRIUM_UI_DYLIB");
+  if (!dylib_path) {
+    return;
+  }
+  void* handle = dlopen(dylib_path, RTLD_NOW);
+  if (!handle) {
+    return;
+  }
+  create_sidebar_ = reinterpret_cast<void* (*)(AtriumHost*, const AtriumHostOps*)>(
+      dlsym(handle, "AtriumCreateSidebarConnected"));
+  on_added_ = reinterpret_cast<void (*)(uint64_t)>(dlsym(handle, "AtriumOnTabAdded"));
+  on_closed_ = reinterpret_cast<void (*)(uint64_t)>(dlsym(handle, "AtriumOnTabClosed"));
+  on_activated_ =
+      reinterpret_cast<void (*)(uint64_t)>(dlsym(handle, "AtriumOnTabActivated"));
+  on_url_ = reinterpret_cast<void (*)(uint64_t, const char*)>(
+      dlsym(handle, "AtriumOnTabURLChanged"));
+  on_title_ = reinterpret_cast<void (*)(uint64_t, const char*)>(
+      dlsym(handle, "AtriumOnTabTitleChanged"));
+  connected_ = create_sidebar_ && on_added_ && on_closed_ && on_activated_ &&
+               on_url_ && on_title_;
+}
+
+NSView* TabHost::CreateSidebar() {
+  if (!connected_) {
+    return nil;
+  }
+  // The Swift side returns the view retained (+1); take ownership.
+  return (__bridge_transfer NSView*)create_sidebar_(nullptr, &kHostOps);
+}
+
+void TabHost::OnShellCreated(content::Shell* shell) {
+  if (connected_) {
+    on_added_(IdFor(shell));
+  }
+}
+
+void TabHost::OnShellClosed(content::Shell* shell) {
+  if (connected_) {
+    on_closed_(IdFor(shell));
+  }
+}
+
+void TabHost::OnShellActivated(content::Shell* shell) {
+  if (connected_) {
+    on_activated_(IdFor(shell));
+  }
+}
+
+void TabHost::OnURLChanged(content::Shell* shell, const GURL& url) {
+  if (connected_) {
+    on_url_(IdFor(shell), url.spec().c_str());
+  }
+}
+
+void TabHost::OnTitleChanged(content::Shell* shell, const std::u16string& title) {
+  if (connected_) {
+    on_title_(IdFor(shell), base::UTF16ToUTF8(title).c_str());
+  }
+}
+
+}  // namespace atrium
