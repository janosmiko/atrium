   DCHECK(!shell_data_map_.contains(shell));
   ShellData& shell_data = shell_data_map_[shell];
 
+  if (atrium::TabHost::Get()->connected() && g_atrium_window) {
+    // Reuse the first window; this shell becomes a background tab.
+    shell_data.delegate = [[ContentShellWindowDelegate alloc]
+        initWithShell:shell
