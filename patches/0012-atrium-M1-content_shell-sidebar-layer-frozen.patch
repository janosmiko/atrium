+// --- Atrium M0: SwiftUI sidebar loaded from an external dylib ---
+#include <dlfcn.h>
+
+namespace {
+
+constexpr CGFloat kAtriumSidebarWidth = 220;
+
+// Window shared by all Atrium tabs (M1: single-window model).
+static NSWindow* g_atrium_window = nil;
+
+// Declared in ShellPlatformDelegate (header addition below).
+
+// Loads the AtriumUI dylib (path via ATRIUM_UI_DYLIB) and creates the
+// SwiftUI sidebar NSView. Returns nil if the dylib is absent, in which
+// case content_shell behaves exactly as upstream.
+NSView* AtriumLoadSidebarView() {
+  const char* dylib_path = getenv("ATRIUM_UI_DYLIB");
+  if (!dylib_path) {
+    return nil;
+  }
+  static void* handle = dlopen(dylib_path, RTLD_NOW);
+  if (!handle) {
+    return nil;
+  }
+  using Factory = void* (*)(void);
+  auto factory =
+      reinterpret_cast<Factory>(dlsym(handle, "AtriumCreateSidebarView"));
+  if (!factory) {
+    return nil;
+  }
+  return (__bridge_transfer NSView*)factory();
+}
+
+}  // namespace
+// --- end Atrium M0 ---
+
 // Receives notification that the window is closing so that it can start the
 // tear-down process.
 @interface ContentShellWindowDelegate : NSObject <NSWindowDelegate>
@@ -56,6 +93,42 @@
 // removed from the screen.
 - (BOOL)windowShouldClose:(id)sender {
   CHECK_EQ(base::apple::ObjCCastStrict<NSWindow>(sender), _window);
+  if (atrium::TabHost::Get()->connected() && _window == g_atrium_window) {
+    // Closing tabs below can synchronously erase the map entry holding the
+    // only strong reference to |self|; keep it alive for the whole method.
+    __attribute__((objc_precise_lifetime)) ContentShellWindowDelegate*
+        protect_self = self;
+    // Cmd+W reaches here as a key event (directly or via Chromium's
+    // re-dispatch of unhandled keys to the main menu); the red titlebar
+    // button as a mouse event. No current event also closes the window.
+    NSEventType event_type = NSApp.currentEvent.type;
+    bool key_initiated = event_type == NSEventTypeKeyDown ||
+                         event_type == NSEventTypeKeyUp ||
+                         event_type == NSEventTypeFlagsChanged;
+    if (key_initiated && content::Shell::windows().size() > 1) {
+      // Atrium: Cmd+W closes the active tab; the shared window stays.
+      content::Shell* target = content::Shell::atrium_active_shell();
+      if (!target) {
+        target = content::Shell::windows().back();
+      }
+      target->Close();
+      return NO;
+    }
+    if (!key_initiated) {
+      // Red titlebar button: the whole window closes. Tear down all other
+      // tabs first, over a copy since Close() mutates windows(). None of
+      // them holds the window delegate (|self| does), so each takes the
+      // keep-window-open DestroyShell path.
+      std::vector<content::Shell*> tabs = content::Shell::windows();
+      for (content::Shell* tab : tabs) {
+        if (tab != _shell.get()) {
+          tab->Close();
+        }
+      }
+    }
+    // Only |_shell| remains: the shared window goes away with it.
+    g_atrium_window = nil;
+  }
   // Don't leave a dangling pointer if the window lives beyond
   // this method. See crbug.com/719830.
   _window.delegate = nil;
