@@ -227,16 +321,47 @@ void ShellPlatformDelegate::SetContents(Shell* shell) {
   web_view.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;
 
   NSWindow* window = shell_data.delegate.window;
-  [window.contentView addSubview:web_view];
 
   NSRect frame = window.contentView.bounds;
   if (!Shell::ShouldHideToolbar()) {
     frame.size.height -= kURLBarHeight;
   }
+  if (atrium::TabHost::Get()->connected()) {
+    frame.origin.x += kAtriumSidebarWidth;
+    frame.size.width -= kAtriumSidebarWidth;
+    web_view.hidden = (shell != Shell::atrium_active_shell());
+  } else if (NSView* sidebar = AtriumLoadSidebarView()) {
