+// swift/AtriumUI/Sources/AtriumBridgeC/include/atrium_bridge.h
+// C ABI between the AtriumUI dylib (Swift) and the Chromium-side patch.
+// MUST stay byte-identical with content/shell/browser/atrium_bridge.h
+// in the Chromium tree (see Global Constraints).
+#ifndef ATRIUM_BRIDGE_H_
+#define ATRIUM_BRIDGE_H_
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// Opaque handle owned by the Chromium side.
+typedef struct AtriumHost AtriumHost;
+
+// Operations the Swift UI invokes on the browser. All functions are
+// called on the main thread. tab_id identifies a tab previously
+// announced via AtriumOnTabAdded.
+typedef struct AtriumHostOps {
+  void (*navigate)(AtriumHost* host, uint64_t tab_id, const char* url);
+  void (*new_tab)(AtriumHost* host);
+  void (*close_tab)(AtriumHost* host, uint64_t tab_id);
+  void (*activate_tab)(AtriumHost* host, uint64_t tab_id);
+  void (*go_back)(AtriumHost* host, uint64_t tab_id);
+  void (*go_forward)(AtriumHost* host, uint64_t tab_id);
+  void (*reload)(AtriumHost* host, uint64_t tab_id);
+} AtriumHostOps;
+
+#ifdef __cplusplus
+}  // extern "C"
+#endif
+
+#endif  // ATRIUM_BRIDGE_H_
diff --git a/content/shell/browser/atrium_tab_host.h b/content/shell/browser/atrium_tab_host.h
