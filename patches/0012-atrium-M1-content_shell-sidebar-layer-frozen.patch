--- /dev/null
+++ b/content/shell/browser/atrium_tab_host.h
@@ -0,0 +1,63 @@
+// content/shell/browser/atrium_tab_host.h
+#ifndef CONTENT_SHELL_BROWSER_ATRIUM_TAB_HOST_H_
+#define CONTENT_SHELL_BROWSER_ATRIUM_TAB_HOST_H_
+
+// This header is included from both Objective-C++ (.mm) and plain C++ (.cc)
+// translation units. NSView is only usable as a pointer type in the latter.
+#if defined(__OBJC__)
+#import <Cocoa/Cocoa.h>
+#else
+class NSView;
+#endif
+
+#include <cstdint>
+#include <string>
+
+#include "content/shell/browser/atrium_bridge.h"
+#include "url/gurl.h"
+
+namespace content {
+class Shell;
+}
+
+namespace atrium {
+
+// Bridges content_shell Shells (= tabs) to the AtriumUI dylib. One
+// process-wide instance; all calls on the UI thread. If the dylib is
+// missing every method degrades to a no-op and content_shell behaves
+// as upstream.
+class TabHost {
+ public:
+  static TabHost* Get();
+
+  bool connected() const { return connected_; }
+  NSView* CreateSidebar();
+
+  void OnShellCreated(content::Shell* shell);
+  void OnShellClosed(content::Shell* shell);
+  void OnShellActivated(content::Shell* shell);
+  void OnURLChanged(content::Shell* shell, const GURL& url);
+  void OnTitleChanged(content::Shell* shell, const std::u16string& title);
+
+  static uint64_t IdFor(content::Shell* shell) {
+    return reinterpret_cast<uint64_t>(shell);
+  }
+
+ private:
+  TabHost();
+  bool connected_ = false;
+
+  // Swift-side entry points resolved via dlsym.
+  void (*on_added_)(uint64_t) = nullptr;
+  void (*on_closed_)(uint64_t) = nullptr;
+  void (*on_activated_)(uint64_t) = nullptr;
+  void (*on_url_)(uint64_t, const char*) = nullptr;
+  void (*on_title_)(uint64_t, const char*) = nullptr;
+  // Returns a retained NSView* (+1); CreateSidebar() balances it with
+  // __bridge_transfer.
+  void* (*create_sidebar_)(AtriumHost*, const AtriumHostOps*) = nullptr;
+};
+
+}  // namespace atrium
+
+#endif  // CONTENT_SHELL_BROWSER_ATRIUM_TAB_HOST_H_
diff --git a/content/shell/browser/atrium_tab_host.mm b/content/shell/browser/atrium_tab_host.mm
new file mode 100644
