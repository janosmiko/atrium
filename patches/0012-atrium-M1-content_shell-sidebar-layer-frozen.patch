+    g_atrium_window = window;
+    NSView* sidebar = atrium::TabHost::Get()->CreateSidebar();
+    if (sidebar) {
+      NSRect side = window.contentView.bounds;
+      if (!Shell::ShouldHideToolbar()) side.size.height -= kURLBarHeight;
+      side.size.width = kAtriumSidebarWidth;
+      sidebar.frame = side;
+      sidebar.autoresizingMask = NSViewHeightSizable | NSViewMaxXMargin;
+      [window.contentView addSubview:sidebar];
