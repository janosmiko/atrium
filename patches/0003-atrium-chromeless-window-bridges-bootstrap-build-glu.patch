 BrowserWindow::CreateBrowserWindow(Browser* browser,
                                    bool user_gesture,
                                    bool in_tab_dragging) {
+#if BUILDFLAG(IS_MAC)
+  if (atrium::UIBridge::Get()->connected() && browser->is_type_normal()) {
