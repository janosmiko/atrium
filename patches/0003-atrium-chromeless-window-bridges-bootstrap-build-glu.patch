diff --git a/chrome/browser/ui/browser.cc b/chrome/browser/ui/browser.cc
index 0777bf71430c8..622a8c0f64303 100644
--- a/chrome/browser/ui/browser.cc
+++ b/chrome/browser/ui/browser.cc
@@ -292,6 +292,10 @@
 #endif
 
 #if BUILDFLAG(IS_MAC)
+#include "chrome/browser/ui/atrium/atrium_peek_intercept.h"
+#include "chrome/browser/ui/atrium/atrium_status_bubble_hook.h"
+#include "chrome/browser/ui/atrium/atrium_traffic_routing.h"
+#include "chrome/browser/ui/atrium/atrium_ui_bridge.h"
 #include "ui/display/display.h"
 #include "ui/display/screen.h"
 #include "ui/display/types/display_constants.h"
@@ -1513,6 +1517,32 @@ WebContents* Browser::OpenURLFromTab(
     }
   }
 
+#if BUILDFLAG(IS_MAC)
+  // Peek mode (2026-07-10 plan, Q1): shift+click on Mac maps to
+  // NEW_WINDOW (ui/base/window_open_disposition_utils.cc's
+  // DispositionFromClick) - intercept it here, before a real window/tab is
+  // created, and show the target in a floating preview widget instead.
+  // started_from_context_menu excludes "Open Link in New Window" (also
+  // NEW_WINDOW) so an explicit user choice is never swallowed;
+  // is_renderer_initiated excludes any browser-initiated NEW_WINDOW open.
+  // peek_connected() is the real dlsym'd fourth ABI-group gate (Task 2) -
+  // same AND-gate shape as every other optional group here. A dylib missing
+  // any of the four peek exports leaves this false and shift+click falls
+  // through to stock NEW_WINDOW behavior below.
+  if (params.disposition == WindowOpenDisposition::NEW_WINDOW &&
+      params.is_renderer_initiated && !params.started_from_context_menu &&
+      atrium::UIBridge::Get()->connected() &&
+      atrium::UIBridge::Get()->peek_connected() &&
+      atrium::MaybeOpenPeek(this, source, params.url, params.referrer)) {
+    return source;  // No new WebContents/window created on this path.
+  }
+  // Auto-peek for a plain (unmodified) cross-site link click from a
+  // pinned/favorited tab (M2, 2026-07-14 plan) is NOT hooked here: a plain
+  // click never emits the OpenURL IPC that reaches this method (see the
+  // plan's "INTERCEPT RE-ADJUDICATION"), so it lives in
+  // atrium_peek_navigation_throttle instead.
+#endif  // BUILDFLAG(IS_MAC)
+
   NavigateParams nav_params(this, params.url, params.transition);
   nav_params.FillNavigateParamsFromOpenURLParams(params);
   nav_params.source_contents = source;
@@ -1684,6 +1714,21 @@ content::WebContents* Browser::AddNewContents(
     }
   }
 
+#if BUILDFLAG(IS_MAC)
+  // Traffic routing Hook 2 (window.open, 2026-07-10 plan Task 4): the
+  // renderer already pre-created `new_contents` and started its initial
+  // load before Chromium reaches this point - Hook 1 (chrome::Navigate(),
+  // browser_navigator.cc) never sees a window.open's URL at all, so this is
+  // the only place that can catch it. A cross-profile match destroys
+  // `new_contents` and reopens the URL on the target profile's controller
+  // instead of ever inserting it into this Browser's strip; a same-profile
+  // match or a non-match falls through unchanged.
+  if (atrium::MaybeRerouteNewContents(this, source, new_contents,
+                                      target_url)) {
+    return nullptr;
+  }
+#endif  // BUILDFLAG(IS_MAC)
+
   return chrome::AddWebContents(this, source, std::move(new_contents),
                                 target_url, disposition, window_features,
                                 window_action, user_gesture);
@@ -1737,6 +1782,12 @@ void Browser::SetContentsBounds(WebContents* source, const gfx::Rect& bounds) {
 }
 
 void Browser::UpdateTargetURL(WebContents* source, const GURL& url) {
+#if BUILDFLAG(IS_MAC)
+  // AtriumBrowserWindow::GetStatusBubbles() stays stubbed
+  // (returns {}, see atrium_status_bubble_hook.h's doc), so the loop below is
+  // always a no-op for Atrium - this is the real seam instead.
+  atrium::MaybeUpdateStatusBubbleURL(this, source, url);
+#endif  // BUILDFLAG(IS_MAC)
   std::vector<StatusBubble*> status_bubbles = GetStatusBubbles();
   for (StatusBubble* status_bubble : status_bubbles) {
     StatusBubbleViews* status_bubble_views =
diff --git a/chrome/browser/ui/browser_window/internal/browser_window_features.cc b/chrome/browser/ui/browser_window/internal/browser_window_features.cc
index 4913c63016ccc..0ab887d1ada99 100644
--- a/chrome/browser/ui/browser_window/internal/browser_window_features.cc
+++ b/chrome/browser/ui/browser_window/internal/browser_window_features.cc
@@ -47,6 +47,7 @@
 #include "chrome/browser/tab_group_sync/tab_group_sync_service_factory.h"
 #include "chrome/browser/ui/ai_overlay_dialog/ai_overlay_dialog_controller.h"
 #include "chrome/browser/ui/animation/browser_animation_controller.h"
+#include "chrome/browser/ui/atrium/atrium_feature_check.h"
 #include "chrome/browser/ui/bookmarks/bookmark_bar_controller.h"
 #include "chrome/browser/ui/bookmarks/bookmarks_service_feature.h"
 #include "chrome/browser/ui/breadcrumb_manager_browser_agent.h"
@@ -1065,6 +1066,28 @@ void BrowserWindowFeatures::InitPostWindowConstruction(Browser* browser) {
     }
   }
 
+  // Atrium: AtriumBrowserWindow is not a BrowserView, so
+  // InitPostBrowserViewConstruction (which Init()s the impl for normal
+  // windows) never runs for Atrium-backed (type-normal) windows -- other
+  // window types in an Atrium-connected process (DevTools, popups, apps,
+  // app-popups, picture-in-picture) still get real BrowserViews and are
+  // Init'd there as usual. Mirror the window factory's gate exactly
+  // (browser_window_factory.cc) so this only fires for the windows that
+  // actually get an AtriumBrowserWindow. Init the impl here with the live
+  // Atrium widget's root view so
+  // BrowserElementsViews::GetPrimaryWindowWidget()/GetContext() return the
+  // real widget/context and tab-modal dialogs stop crashing.
+  if (atrium::IsAtriumBrowserWindowEnabled() && browser->is_type_normal()) {
+    if (auto* const provider =
+            browser_elements_->AsA<BrowserElementsViewsImpl>()) {
+      if (views::Widget* const widget =
+              views::Widget::GetWidgetForNativeWindow(
+                  browser->window()->GetNativeWindow())) {
+        provider->Init(widget->GetRootView());
+      }
+    }
+  }
+
   // Initialize post-window dependent embedder features last.
   embedder_browser_window_features_->InitPostWindowConstruction(browser);
 }
