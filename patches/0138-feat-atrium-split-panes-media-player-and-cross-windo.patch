+// Atrium's `autoMiniPlayer` setting, one test per acceptance criterion. The
+// page these three use never registers the enterpictureinpicture action, which
+// is what separates `audible` from Chromium's own `siteAsks` rule.
+IN_PROC_BROWSER_TEST_F(AutoPictureInPictureWithVideoPlaybackBrowserTest,
+                       AtriumAudibleTakesAnUnregisteredVideo) {
+  atrium::SetAutoMiniPlayer(atrium::AutoMiniPlayer::kAudible);
+  LoadNotRegisteredPage(browser());
+  auto* web_contents = browser()->tab_strip_model()->GetActiveWebContents();
+  PlayVideo(web_contents);
+  WaitForAudioFocusGained();
+  WaitForMediaSessionPlaying(web_contents);
+  WaitForWasRecentlyAudible(web_contents);
+  SetExpectedHasHighEngagement(true);
+
+  SwitchToNewTabAndBackAndExpectAutopip(/*should_video_pip=*/true,
+                                        /*should_document_pip=*/false);
+}
+
+IN_PROC_BROWSER_TEST_F(AutoPictureInPictureWithVideoPlaybackBrowserTest,
+                       AtriumAudibleLeavesAMutedVideoInItsTab) {
+  atrium::SetAutoMiniPlayer(atrium::AutoMiniPlayer::kAudible);
+  LoadNotRegisteredPage(browser());
+  auto* web_contents = browser()->tab_strip_model()->GetActiveWebContents();
+  PlayVideo(web_contents);
+  WaitForAudioFocusGained();
+  WaitForMediaSessionPlaying(web_contents);
+  SetExpectedHasHighEngagement(true);
+
+  WaitForWasRecentlyAudible(web_contents, /*expected_recently_audible=*/true);
+  MuteVideo(web_contents);
+  WaitForWasRecentlyAudible(web_contents, /*expected_recently_audible=*/false);
+
+  SwitchToNewTabAndDontExpectAutopip();
+}
+
+// The registered, audible page Chromium itself would take, so a pass here is
+// the setting refusing rather than the page failing some other condition.
+IN_PROC_BROWSER_TEST_F(AutoPictureInPictureWithVideoPlaybackBrowserTest,
+                       AtriumOffOpensNothingAutomatically) {
+  atrium::SetAutoMiniPlayer(atrium::AutoMiniPlayer::kOff);
+  LoadAutoVideoPipPage(browser());
+  auto* web_contents = browser()->tab_strip_model()->GetActiveWebContents();
+  PlayVideo(web_contents);
+  WaitForAudioFocusGained();
+  WaitForMediaSessionPlaying(web_contents);
+  WaitForWasRecentlyAudible(web_contents);
+  SetExpectedHasHighEngagement(true);
+
+  SwitchToNewTabAndDontExpectAutopip();
+}
