+void VideoOverlayWindowViews::ToggleAlwaysOnTop() {
+  const bool enabled = !atrium::PipAlwaysOnTop();
+  atrium::PipAlwaysOnTop() = enabled;
+  SetZOrderLevel(enabled ? ui::ZOrderLevel::kFloatingWindow
+                         : ui::ZOrderLevel::kNormal);
+  atrium::SavePipAlwaysOnTop(enabled);
+  always_on_top_button_->SetIcon(
+      enabled ? (features::IsRoundedIconsEnabled() ? kKeepIcon : kKeepOldIcon)
+              : (features::IsRoundedIconsEnabled() ? kKeepOffIcon
+                                                   : kKeepOffOldIcon));
+}
