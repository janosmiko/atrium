+TEST_F(VideoOverlayWindowViewsTest, AlwaysOnTopButtonTogglesZOrder) {
+  overlay_window().ForceControlsVisibleForTesting(true);
+  SimpleOverlayWindowImageButton* always_on_top_button =
+      overlay_window().always_on_top_button_for_testing();
+  ASSERT_NE(nullptr, always_on_top_button);
+  EXPECT_TRUE(always_on_top_button->IsDrawn());
+
+  views::test::ButtonTestApi always_on_top_button_clicker(
+      always_on_top_button);
+  ui::MouseEvent dummy_event(ui::EventType::kMousePressed, gfx::Point(0, 0),
+                             gfx::Point(0, 0), ui::EventTimeForNow(), 0, 0);
+  const ui::ZOrderLevel initial_z_order = overlay_window().GetZOrderLevel();
+
+  // Clicking the always-on-top button flips the widget's z-order.
+  always_on_top_button_clicker.NotifyClick(dummy_event);
+  EXPECT_NE(initial_z_order, overlay_window().GetZOrderLevel());
+
+  // Clicking it again restores the original z-order.
+  always_on_top_button_clicker.NotifyClick(dummy_event);
+  EXPECT_EQ(initial_z_order, overlay_window().GetZOrderLevel());
+}
+
+TEST_F(VideoOverlayWindowViewsTest, JumpToStartButtonSeeksToZero) {
