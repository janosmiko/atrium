+    "//chrome/browser/ui/atrium:restore_plan",
     "//chrome/browser/ui/atrium:slot_presentation_table",
     "//chrome/browser/ui/atrium:status_bubble_color_math",
     "//chrome/browser/ui/atrium:surface_key_route",
