 }
 
 views::Widget* BrowserElementsViewsImpl::GetPrimaryWindowWidget() {
+  // On Atrium, this instance's own widget can be hidden while a
+  // different profile's window presents this Browser's WebContents (a
+  // cross-profile in-window swap) - see the hook's doc for why anchoring a
+  // tab-modal dialog to it would be invisible to the user. Null (and this
+  // check itself) is a no-op on every other BrowserWindow, including
+  // non-Atrium Chromium builds.
+  if (views::Widget* override_widget =
+          atrium::GetTabModalDialogHostOverride(&*browser_)) {
+    return override_widget;
+  }
   return context_view_ ? context_view_->GetWidget() : nullptr;
 }
 
