   ToolbarButtonProvider* button_provider =
-      BrowserView::GetBrowserViewForBrowser(browser)->toolbar_button_provider();
+      browser_view->toolbar_button_provider();
+  if (!button_provider) {
+    return;
+  }
 
   // Writable files or directories are generally also readable, but we don't
   // want to display the same path twice. So filter out any writable paths from
@@ -552,10 +565,24 @@ std::u16string FileSystemAccessUsageBubbleView::GetAccessibleWindowTitle()
     return {};
   }
 
+  // Atrium (defensive): same chromeless null-BrowserView guard as
+  // ShowBubble() above.
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+  if (!browser_view) {
+    return {};
+  }
+
+  // Atrium: toolbar_button_provider() can also be null here (registration
+  // is conditional, see toolbar_view.cc), and GetPageActionViewInterface()
+  // itself may return null (e.g. in system web app windows). Fall back to the
+  // same empty title used for the other missing-anchor cases above.
+  ToolbarButtonProvider* button_provider =
+      browser_view->toolbar_button_provider();
+  if (!button_provider) {
+    return {};
+  }
   auto* page_action_view =
-      BrowserView::GetBrowserViewForBrowser(browser)
-          ->toolbar_button_provider()
-          ->GetPageActionViewInterface(kActionShowFileSystemAccess);
+      button_provider->GetPageActionViewInterface(kActionShowFileSystemAccess);
   if (!page_action_view) {
     return {};
   }
diff --git a/chrome/browser/ui/views/hats/hats_next_web_dialog.cc b/chrome/browser/ui/views/hats/hats_next_web_dialog.cc
index bb71e8cb4d09c..32352ecb3ac62 100644
--- a/chrome/browser/ui/views/hats/hats_next_web_dialog.cc
+++ b/chrome/browser/ui/views/hats/hats_next_web_dialog.cc
@@ -84,13 +84,20 @@ void LogUmaHistogramSparse(
 }
 
 views::BubbleAnchor GetBubbleAnchor(BrowserWindowInterface* browser) {
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+  // Chromeless Atrium windows have no BrowserView, so this can be
+  // null here - HaTS surveys are launched off the active tab's WebContents
+  // (HatsServiceDesktop::LaunchSurveyForWebContents), not gated on a
+  // toolbar-bearing window. Degrade to the same anchor-less BubbleAnchor()
+  // already returned below when there's no app menu button to anchor to.
+  if (!browser_view) {
+    return views::BubbleAnchor();
+  }
   if (browser->GetType() == BrowserWindowInterface::Type::TYPE_DEVTOOLS) {
-    return views::BubbleAnchor(
-        BrowserView::GetBrowserViewForBrowser(browser)->top_container());
+    return views::BubbleAnchor(browser_view->top_container());
   }
-  auto* control = BrowserView::GetBrowserViewForBrowser(browser)
-                      ->toolbar_button_provider()
-                      ->GetAppMenuControl();
+  auto* control =
+      browser_view->toolbar_button_provider()->GetAppMenuControl();
   return control ? control->GetAnchor() : views::BubbleAnchor();
 }
 
