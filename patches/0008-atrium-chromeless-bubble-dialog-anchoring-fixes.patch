diff --git a/chrome/browser/ui/views/bubble_anchor_util_views.cc b/chrome/browser/ui/views/bubble_anchor_util_views.cc
index fdf8dfc8f4d94..89df49e5f06b7 100644
--- a/chrome/browser/ui/views/bubble_anchor_util_views.cc
+++ b/chrome/browser/ui/views/bubble_anchor_util_views.cc
@@ -35,6 +35,17 @@ AnchorConfiguration GetPageInfoAnchorConfiguration(
   auto* location_bar_view =
       browser_view ? browser_view->GetLocationBarView() : nullptr;
 
+  // Atrium: a chromeless window has no BrowserView/LocationBar/toolbar, so
+  // every anchor path below unconditionally dereferences one of them (e.g.
+  // location_bar_view->IsDrawn(), browser_view->toolbar()) and null-derefs -
+  // a permission prompt (geolocation, notifications, camera/mic) crashed the
+  // browser here. Return an empty configuration, the function's own
+  // documented "fall back to a default corner position" contract, so the
+  // bubble anchors to a window corner instead of crashing.
+  if (!browser_view || !location_bar_view) {
+    return {};
+  }
+
   if (base::FeatureList::IsEnabled(
           content_settings::features::kLeftHandSideActivityIndicators) &&
       location_bar_view) {
@@ -162,6 +173,16 @@ gfx::Rect GetPageInfoAnchorRect(BrowserWindowInterface* browser) {
   DCHECK(GetPageInfoAnchorConfiguration(browser).anchor.IsNull());
 
   BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+  // Atrium: a chromeless window has no BrowserView, so the GetMirroredXInView
+  // deref below null-crashes (the sibling of the GetPageInfoAnchorConfiguration
+  // guard - a permission prompt reaches here once that returns an empty
+  // anchor). Anchor the bubble to the window's top-leading corner instead of
+  // crashing; the caller has already parented it to the window.
+  if (!browser_view) {
+    gfx::Rect window_bounds =
+        browser->GetBrowserForMigrationOnly()->window()->GetBounds();
+    return gfx::Rect(window_bounds.origin(), gfx::Size());
+  }
   // Get position in view (taking RTL UI into account).
   int x_within_browser_view = browser_view->GetMirroredXInView(
       bubble_anchor_util::kNoToolbarLeftOffset);
diff --git a/chrome/browser/ui/views/file_system_access/file_system_access_usage_bubble_view.cc b/chrome/browser/ui/views/file_system_access/file_system_access_usage_bubble_view.cc
