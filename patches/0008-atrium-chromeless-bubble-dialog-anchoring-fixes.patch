@@ -461,8 +461,21 @@ void FileSystemAccessUsageBubbleView::ShowBubble(
     return;
   }
 
+  // Atrium (defensive): a chromeless window has no BrowserView, so the
+  // toolbar_button_provider() deref below would crash. Reachability of this
+  // path in Atrium is unconfirmed; guard it anyway rather than crash.
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+  if (!browser_view) {
+    return;
+  }
+  // Atrium: toolbar_button_provider() registration is conditional even when
+  // browser_view is non-null (see toolbar_view.cc), so it can still be null
