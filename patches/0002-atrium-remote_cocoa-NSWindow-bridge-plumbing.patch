+
+// Atrium: translucent windows (liquid-glass browser window) paint their own
+// background, which AppKit's frame does not corner-mask, so the compositor
+// surface would show square corners against the frame's rounded shadow. Clip
+// the content view to the frame's own radius instead of a hardcoded value:
+// -_getCachedWindowCornerRadius is the same source of truth the frame uses
+// and already version-gates (concentric 20 on macOS 26, native default
+// before), so the content stays flush with the window shape across OS
+// versions.
+void NativeWidgetNSWindowBridge::UpdateContentCornerMask(bool for_fullscreen) {
+  if (!bridged_view_) {
+    return;
+  }
+  // A non-opaque window (Atrium's liquid-glass browser window paints its own
+  // clear background) is the case AppKit doesn't corner-mask for us. The
+  // explicit opt-in flag only reaches the out-of-process path, so key off the
+  // window's own opacity here - self-contained and correct for every window
+  // that actually needs it.
+  // Only a non-opaque window (Atrium's liquid-glass browser window paints its
+  // own clear background) needs this - AppKit corner-masks opaque windows for
+  // free. The initial windowed rounding is applied by InstallLiquidGlassBackdrop
+  // when the window first goes non-opaque; this path re-applies across
+  // fullscreen transitions (radius 0 in fullscreen, restored on exit).
+  if (![window_ isOpaque]) {
+    // proceed
+  } else if (!rounds_content_corners_to_window_) {
+    return;
+  }
+  CGFloat radius = 0;
+  // Fullscreen content fills the screen edge-to-edge; no rounding there.
+  if (!for_fullscreen) {
+    NSView* frame_view = [bridged_view_ superview];
+    if ([frame_view
+            respondsToSelector:@selector(_getCachedWindowCornerRadius)]) {
+      radius = [frame_view _getCachedWindowCornerRadius];
+    }
+    // On macOS 26 the window silhouette uses the concentric radius 20
+    // (13pt widget inset + 7pt widget radius, per BrowserWindowFrame's own
+    // -_getCachedWindowCornerRadius override). The frame view can hand back
+    // the legacy ~11pt default here, which leaves the content noticeably
+    // tighter than the Tahoe frame - clamp up so the two stay concentric.
+    if (@available(macOS 26, *)) {
+      if (radius < 20) {
+        radius = 20;
+      }
+    }
+  }
+  bridged_view_.layer.cornerRadius = radius;
+  bridged_view_.layer.masksToBounds = radius > 0;
+  if (@available(macOS 26, *)) {
+    // macOS 26 window corners use continuous (squircle) curvature.
+    bridged_view_.layer.cornerCurve = kCACornerCurveContinuous;
+  }
 }
 
