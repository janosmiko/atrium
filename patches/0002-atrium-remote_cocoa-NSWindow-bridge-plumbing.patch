+void NativeWidgetNSWindowBridge::SetExcludedFromWindowCycling(bool excluded) {
+  window_.excludedFromWindowsMenu = excluded;
+
+  // Strip the managed/transient collection behavior bits; they will be reset
+  // below. Leaves every other bit (e.g. fullscreen-related, set elsewhere in
+  // this file) untouched.
+  NSWindowCollectionBehavior behavior =
+      window_.collectionBehavior & ~(NSWindowCollectionBehaviorManaged |
+                                     NSWindowCollectionBehaviorTransient);
+  window_.collectionBehavior =
+      behavior | (excluded ? NSWindowCollectionBehaviorTransient
+                           : NSWindowCollectionBehaviorManaged);
+}
