     "//chrome/browser/ui/atrium:window_appearance",
@@ -3485,6 +3485,8 @@ static_library("ui") {
       "atrium/atrium_command_bar_open_reason.h",
       "atrium/atrium_dock_reopen_hook.h",
       "atrium/atrium_dock_reopen_hook.cc",
+      "atrium/atrium_external_link_hook.h",
+      "atrium/atrium_external_link_hook.cc",
       "atrium/atrium_extension_bridge.h",
       "atrium/atrium_extension_bridge.cc",
