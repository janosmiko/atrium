diff --git a/chrome/browser/ui/extensions/extension_dialog_utils_views.cc b/chrome/browser/ui/extensions/extension_dialog_utils_views.cc
index 011fcf743fae8..1944417b623de 100644
--- a/chrome/browser/ui/extensions/extension_dialog_utils_views.cc
+++ b/chrome/browser/ui/extensions/extension_dialog_utils_views.cc
@@ -87,8 +87,18 @@ void ShowDialog(ExtensionsToolbarDesktop* container,
 
 void ShowDialog(BrowserWindowInterface* browser,
                 std::unique_ptr<ui::DialogModel> dialog_model) {
+  BrowserView* browser_view =
+      BrowserView::GetBrowserViewForBrowser(browser);
+  if (!browser_view) {
+    // No BrowserView (e.g. chromeless window) means no toolbar to anchor to.
+    // Fall back to a browser-modal dialog parented to the native window.
+    ShowModalDialog(browser->GetWindow()->GetNativeWindow(),
+                    std::move(dialog_model));
+    return;
+  }
+
   ToolbarButtonProvider* toolbar_button_provider =
-      BrowserView::GetBrowserViewForBrowser(browser)->toolbar_button_provider();
+      browser_view->toolbar_button_provider();
   CHECK(toolbar_button_provider);
 
