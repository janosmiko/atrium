-
-TabHost::TabHost() {
-  const char* dylib_path = getenv("ATRIUM_UI_DYLIB");
-  if (!dylib_path) {
-    return;
-  }
-  void* handle = dlopen(dylib_path, RTLD_NOW);
-  if (!handle) {
-    return;
-  }
-  create_sidebar_ = reinterpret_cast<void* (*)(AtriumHost*, const AtriumHostOps*)>(
-      dlsym(handle, "AtriumCreateSidebarConnected"));
-  on_added_ = reinterpret_cast<void (*)(uint64_t)>(dlsym(handle, "AtriumOnTabAdded"));
-  on_closed_ = reinterpret_cast<void (*)(uint64_t)>(dlsym(handle, "AtriumOnTabClosed"));
-  on_activated_ =
-      reinterpret_cast<void (*)(uint64_t)>(dlsym(handle, "AtriumOnTabActivated"));
-  on_url_ = reinterpret_cast<void (*)(uint64_t, const char*)>(
-      dlsym(handle, "AtriumOnTabURLChanged"));
-  on_title_ = reinterpret_cast<void (*)(uint64_t, const char*)>(
-      dlsym(handle, "AtriumOnTabTitleChanged"));
-  connected_ = create_sidebar_ && on_added_ && on_closed_ && on_activated_ &&
-               on_url_ && on_title_;
