     "//chrome/browser/ui/atrium:confirm_quit_panel_style",
+    "//chrome/browser/ui/atrium:confirm_to_quit",
     "//chrome/browser:command_updater_impl",
     "//chrome/browser:global_keyboard_shortcuts_mac",
