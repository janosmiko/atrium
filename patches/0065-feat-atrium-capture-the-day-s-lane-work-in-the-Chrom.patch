+using ProfileBrowserCollectionFindTabbedBrowserTest = BrowserWithTestWindowTest;
+
+// FindTabbedBrowser must exclude a little window even with
+// no normal window present.
+TEST_F(ProfileBrowserCollectionFindTabbedBrowserTest,
+       ExcludesALittleWindowWithNoNormalWindowPresent) {
+  // Close the fixture's default (non-little) browser so the profile's only
+  // window is the little one added below.
+  browser()->tab_strip_model()->CloseAllTabs();
+  browser()->GetFeatures().TearDownPreBrowserWindowDestruction();
+  std::unique_ptr<Browser> default_browser = release_browser();
+  default_browser.reset();
+
+  std::unique_ptr<Browser> little_browser =
+      CreateBrowser(profile(), Browser::TYPE_NORMAL, /*hosted_app=*/false);
+  atrium::RegisterLittleWindow(little_browser.get());
+
+  EXPECT_EQ(nullptr, ProfileBrowserCollection::GetForProfile(profile())
+                          ->FindTabbedBrowser());
+
+  atrium::UnregisterLittleWindow(little_browser.get());
+  little_browser->tab_strip_model()->CloseAllTabs();
+  little_browser->GetFeatures().TearDownPreBrowserWindowDestruction();
+}
+
+// Unit-level happy path: a normal, non-little window is
+// still found.
+TEST_F(ProfileBrowserCollectionFindTabbedBrowserTest,
+       StillFindsAnOrdinaryNormalWindow) {
+  EXPECT_EQ(browser(), ProfileBrowserCollection::GetForProfile(profile())
+                           ->FindTabbedBrowser()
+                           ->GetBrowserForMigrationOnly());
+}
