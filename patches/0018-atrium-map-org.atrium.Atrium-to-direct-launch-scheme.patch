---
 build/apple/tweak_info_plist.py | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/build/apple/tweak_info_plist.py b/build/apple/tweak_info_plist.py
index e0bf689eeb8f7..51b7ea1768c92 100755
--- a/build/apple/tweak_info_plist.py
+++ b/build/apple/tweak_info_plist.py
@@ -276,6 +276,8 @@ def _SetDirectLaunchUrlScheme(plist, bundle_identifier):
     # this scheme for non-stable channels during signing.
   elif bundle_identifier == 'org.chromium.Chromium':
     scheme = 'chromium'
+  elif bundle_identifier == 'org.atrium.Atrium':
+    scheme = 'atrium'
 
   url_types = plist.get('CFBundleURLTypes')
   if not url_types:
